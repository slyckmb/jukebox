# Jukebox Environment Configuration
# Copy this file to .env and configure for your environment

# === Lidarr Configuration ===
# Lidarr API base URL (default for Docker networking)
LIDARR_URL=http://lidarr:8686/api/v1

# Lidarr API Key - REQUIRED
# Option 1: Store directly (not recommended for production)
# LIDARR_API_KEY=your-api-key-here

# Option 2: Store in file (recommended)
LIDARR_API_KEY_FILE=/mnt/config/secrets/bash/bash_lidarr-api-key.env

# Lidarr Quality Profile ID (default: 1)
LIDARR_QUALITY_PROFILE_ID=1

# Lidarr Metadata Profile ID (default: 1)
LIDARR_METADATA_PROFILE_ID=1

# === Flask Configuration ===
# Flask Secret Key - REQUIRED
# Option 1: Store directly (not recommended for production)
# FLASK_SECRET_KEY=change-me-in-production

# Option 2: Store in file (recommended)
FLASK_SECRET_KEY_FILE=/mnt/config/secrets/jukebox/flask-secret

# === Storage Configuration ===
# Base path for music storage (will create per-user subdirectories)
MUSIC_ROOT_BASE=/data/media/music

# SQLite database path
DB_PATH=/app/data/requests.db

# === Media Server URLs (Optional) ===
# Used for "Listen Now" links when music already exists in library
# Leave empty if you don't use these services
PLEX_URL=https://plex.bikejeepyoga.com
JELLYFIN_URL=https://jellyfin.bikejeepyoga.com
NAVIDROME_URL=https://navidrome.bikejeepyoga.com

# === Cloudflare Configuration (Optional) ===
# Zero Trust API token for email whitelist management
# ZERO_TRUST_TOKEN_FILE=/mnt/config/secrets/cloudflare/zero-trust-token.env
